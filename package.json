{
	"name": "obsidian-couchdb-sync",
	"version": "0.1.0",
	"description": "Simple, reliable, end-to-end encrypted live sync for Obsidian against a self-hosted CouchDB.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": ["obsidian", "couchdb", "sync", "pouchdb"],
	"author": "chrisurf",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/pouchdb-browser": "^6.1.5",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "latest",
		"typescript": "^5.4.0"
	},
	"dependencies": {
		"pouchdb-browser": "^9.0.0"
	}
}
